---
import { NAV } from '../data/guide';
---
<nav class="toc" aria-label="Seções do guia">
  <div class="wrap bar">
    <div class="links" data-toc>
      {NAV.map((g, gi) => (
        <>
          {gi > 0 && <span class="sep" aria-hidden="true"></span>}
          {g.items.map((it) => <a href={`#${it.id}`} data-target={it.id}>{it.label}</a>)}
        </>
      ))}
    </div>
    <button type="button" class="theme-toggle js-only" data-theme-toggle aria-label="Tema: automático">
      <svg class="i-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"></path></svg>
      <svg class="i-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="i-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
    </button>
  </div>
  <div class="progress" aria-hidden="true"></div>
</nav>

<style>
  .toc { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 8px; min-height: var(--nav-h); }
  .links { flex: 1; display: flex; align-items: center; gap: 2px; overflow-x: auto; scrollbar-width: none; padding: 8px 0; mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent); }
  .links::-webkit-scrollbar { display: none; }
  .links a { flex: none; text-decoration: none; color: var(--muted); font-size: .9rem; font-weight: 500; padding: 6px 10px; border-radius: 6px; transition: background-color .15s, color .15s; }
  .links a:hover { background: var(--surface-2); color: var(--ink); }
  .links a[aria-current="true"] { background: var(--accent-soft); color: var(--accent); }
  .sep { flex: none; width: 1px; height: 18px; background: var(--line); margin: 0 6px; }

  .theme-toggle { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--muted); cursor: pointer; }
  .theme-toggle:hover { color: var(--ink); border-color: var(--accent); }
  .theme-toggle svg { display: none; }
  .theme-toggle[data-mode="auto"] .i-auto,
  .theme-toggle[data-mode="light"] .i-light,
  .theme-toggle[data-mode="dark"] .i-dark { display: block; }

  /* Barra de progresso de leitura: só CSS, onde houver suporte. */
  .progress { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
    @keyframes grow { to { transform: scaleX(1); } }
  }
  @media (prefers-reduced-motion: reduce) { .progress { display: none; } }
</style>

<script>
  // Destaca a seção visível e mantém o link ativo à vista na barra rolável.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const byId = new Map(links.map((a) => [a.dataset.target!, a]));
  const sections = links
    .map((a) => document.getElementById(a.dataset.target!))
    .filter((s): s is HTMLElement => !!s);

  let current = '';
  function setActive(id: string) {
    if (id === current) return;
    current = id;
    links.forEach((a) => a.removeAttribute('aria-current'));
    const a = byId.get(id);
    if (!a) return;
    a.setAttribute('aria-current', 'true');
    const bar = a.parentElement!;
    const left = a.offsetLeft - bar.clientWidth / 2 + a.clientWidth / 2;
    bar.scrollTo({ left, behavior: 'smooth' });
  }

  function onScroll() {
    // A seção ativa é a que cruza a linha a 30% da altura da tela.
    const line = Math.max(160, innerHeight * 0.3);
    let id = '';
    // No fim da página, a última seção fica ativa mesmo que seja curta.
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) {
      setActive(sections[sections.length - 1]?.id ?? '');
      return;
    }
    for (const s of sections) {
      if (s.getBoundingClientRect().top - line <= 0) id = s.id;
    }
    setActive(id);
  }
  let raf = 0;
  addEventListener('scroll', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(onScroll);
  }, { passive: true });
  onScroll();

  // Tema: automático → claro → escuro.
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const NAMES = { auto: 'automático', light: 'claro', dark: 'escuro' } as const;
  type Mode = keyof typeof NAMES;
  function readMode(): Mode {
    const t = document.documentElement.dataset.theme;
    return t === 'light' || t === 'dark' ? t : 'auto';
  }
  function paint(mode: Mode) {
    if (!btn) return;
    btn.dataset.mode = mode;
    btn.setAttribute('aria-label', `Tema: ${NAMES[mode]}. Clique para trocar.`);
    btn.title = `Tema ${NAMES[mode]}`;
  }
  paint(readMode());
  btn?.addEventListener('click', () => {
    const next: Mode = ({ auto: 'light', light: 'dark', dark: 'auto' } as const)[readMode()];
    if (next === 'auto') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = next;
    try {
      if (next === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
    paint(next);
  });
</script>
