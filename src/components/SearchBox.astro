---
interface Props {
  id: string;
  label: string;
  placeholder: string;
}
const { id, label, placeholder } = Astro.props;
---
<div class="search">
  <label for={id} class="visually-hidden">{label}</label>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
  <input id={id} type="search" data-search placeholder={placeholder} autocomplete="off" spellcheck="false" />
</div>
