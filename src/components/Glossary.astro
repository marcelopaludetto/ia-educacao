---
import Section from './Section.astro';
import Ref from './Ref.astro';
import { GLOSSARY } from '../data/guide';
---
<Section id="termos" title="Termos que a norma define" eyebrow="Referência">
  <Ref slot="intro" text="Art. 2º · Anexo I (Glossário)" />
  <dl class="gloss">
    {GLOSSARY.map((g) => (
      <div><dt>{g.term}</dt><dd>{g.def}</dd></div>
    ))}
  </dl>
</Section>

<style>
  .gloss { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin: 0; }
  .gloss div { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
  dt { font-family: var(--font-display); font-weight: 600; margin-bottom: 4px; }
  dd { margin: 0; color: var(--muted); font-size: .94rem; }
</style>
