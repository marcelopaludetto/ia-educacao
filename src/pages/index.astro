---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Toc from '../components/Toc.astro';
import Gist from '../components/Gist.astro';
import Stages from '../components/Stages.astro';
import RulesExplorer from '../components/RulesExplorer.astro';
import RiskLadder from '../components/RiskLadder.astro';
import Curriculum from '../components/Curriculum.astro';
import SchoolDuties from '../components/SchoolDuties.astro';
import Attention from '../components/Attention.astro';
import DocMap from '../components/DocMap.astro';
import Glossary from '../components/Glossary.astro';
import PageViewer from '../components/PageViewer.astro';
---
<Base
  title="IA na Educação Básica: guia das Diretrizes do CNE"
  description="O que as Diretrizes do CNE para uso de Inteligência Artificial na educação permitem e proíbem na Educação Básica: regras por etapa, níveis de risco, deveres da escola e o que mudou desde a minuta."
>
  <Hero />
  <Toc />

  <main id="conteudo" class="wrap" tabindex="-1">
    <Gist />
    <Stages />
    <RulesExplorer />
    <RiskLadder />
    <Curriculum />
    <SchoolDuties />
    <Attention />
    <DocMap />
    <Glossary />
  </main>

  <footer class="wrap">
    <p>Fonte: Parecer CNE/CP 15/2026, com o Projeto de Resolução e os Anexos I e II (Processo 23001.001062/2024-18), homologado por <a href="https://www.in.gov.br/web/dou/-/despacho-mec-de-10-de-novembro-de-2026-743562031">despacho do Ministro da Educação</a> publicado no DOU de 11/11/2026, Seção 1, p. 141, e <a href="/pdfs/resolucao-cne-cp-1-2026.pdf" target="_blank" rel="noopener">Resolução CNE/CP nº 1, de 11/11/2026</a>. Este guia resume e parafraseia; não substitui a leitura do texto nem orientação jurídica.</p>
    <p class="no-print"><a href="#topo">Voltar ao topo ↑</a></p>
  </footer>

  <PageViewer />
</Base>

<script>
  import '../scripts/filterable.ts';
</script>

<style>
  main:focus { outline: none; }
  footer { padding: 48px 20px 64px; color: var(--muted); font-size: .88rem; }
  footer p { max-width: 78ch; }
  footer p:first-child { border-top: 1px solid var(--line); padding-top: 18px; }
  footer p + p { margin-top: 12px; }
</style>
